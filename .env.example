# ==========================================
# ORVIX PDV - CONFIGURAÇÕES DO FIREBASE
# ==========================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Firebase Console
# console.firebase.google.com -> Configurações do Projeto -> Seus Aplicativos (Web)

VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234
VITE_FIREBASE_DATABASE_ID=orvix-pdv-web

# Modo de Operação (true para permitir modo de demonstração local caso offline/sem chaves)
VITE_ALLOW_OFFLINE_DEMO=true

# ==========================================
# PAINEL MASTER / SUPERADMIN (GERENCIADOR DE LICENÇAS)
# ==========================================
# Conta de E-mail Única de Administrador Master (Orvix Master)
VITE_MASTER_ADMIN_EMAIL=orvixsolucoes@gmail.com

